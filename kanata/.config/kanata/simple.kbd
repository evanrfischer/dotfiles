(defcfg
  macos-dev-names-include (
    "Apple Internal Keyboard / Trackpad"
    "Evan’s Magic Keyboard"
    "Karabiner DriverKit VirtualHIDKeyboard 1.8"   
  )
  ;; Crucial for macOS gesture and fn-key timing
  process-unmapped-keys yes
  concurrent-tap-hold yes
)

(defsrc
  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  esc    
  grv   1    2    3    4    5    6    7    8    9    0    -    =   bspc
  tab    q    w    e    r    t    y    u    i    o    p    [    ]     \
  caps    a    s    d    f    g    h    j    k    l    ;    '       ret
  lsft     z    x    c    v    b    n    m    ,    .    /          rsft
  fn lctl   lmet lalt           spc             ralt rmet
)

(deflayer qwerty
  ;; 1. The top row now maps directly to macOS media/system symbols
  🔅    🔆    mctl sls  dtn  dnd  ◀◀   ▶⏸   ▶▶   🔇    🔉    🔊
  caps
  grv   1    2    3    4    5    6    7    8    9    0    -    =   bspc
  tab    q    w    e    r    t    y    u    i    o    p    [    ]     \
  esc     a    s    d    f    g    h    j    k    l    ;    '       ret
  lsft     z    x    c    v    b    n    m    ,    .    /          rsft
  @fn lctl   lmet lalt           spc             ralt rmet
)

(deflayer fn
  ;; 2. Holding the fn key restores access to the actual F1-F12 keys
  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  _
  _     _    _    _    _    _    _    _    _    _    _    _    _   _
  _      _    _    _    _    _    _    _    _    _    _    _    _     _
  _       _    _    _    _    _    _    _    _    _    _    _       _
  _        _    _    _    _    _    _    _    _    _    _          _
  _  _      _    _              _               _    _
)

;; (Num and Layers definitions omitted for brevity, ensure they have the F-row placeholders)

(defalias
  
  ;; 3. The fn alias: 
  ;; Tap: Sends the Globe/Fn key to macOS (for Emoji picker/Language switch)
  ;; Hold: Sends the Fn modifier to the OS AND toggles the F1-F12 layer.
  ;; This allows shortcuts like fn+C (Control Center) to still work.
  fn (tap-hold 200 200 fn (multi fn (layer-toggle fn)))
)